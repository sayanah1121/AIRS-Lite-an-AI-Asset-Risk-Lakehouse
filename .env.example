# AIRS-Lite local environment. Copy to .env and change the secrets.
COMPOSE_PROJECT_NAME=airs
AWS_REGION=us-east-1
S3_ACCESS_KEY=airs
S3_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_PASSWORD=change-me

# Optional: raise API rate limits for the risk catalog (GitHub: 60 -> 5000 requests/hour)
GITHUB_TOKEN=
HF_TOKEN=

# Iceberg REST catalog database (Postgres)
ICEBERG_DB_PASSWORD=change-me
