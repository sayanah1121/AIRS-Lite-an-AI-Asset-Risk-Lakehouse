# Tracewell local environment. Copy to .env and change the secrets.
COMPOSE_PROJECT_NAME=tracewell
AWS_REGION=us-east-1
S3_ACCESS_KEY=tracewell
S3_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_PASSWORD=change-me

# Iceberg REST catalog database (Postgres)
ICEBERG_DB_PASSWORD=change-me
